# yomail - document root of yo.manitra.fr
#
# cPanel "Setup Node.js App" inserts its own block in this file (the lines fenced by
# its "DO NOT REMOVE" comments) to mount the Node app at the ROOT of the subdomain.
# scripts/deploy.sh keeps that block and appends the rules below. Never deploy this
# file by overwriting the server copy blindly, and never quote the fence markers in
# full here: the deploy script looks for them at the start of a line.
#
# Since the webhook-catcher pivot, Nest serves the SPA itself (apps/web/dist) and the
# document root holds nothing but this file. There are no SPA rewrite rules any more:
# every request goes to Node, which routes /api, /<uuid> captures and static assets.

<IfModule mod_passenger.c>
  # Socket.IO runs over HTTP long-polling here (Passenger on Apache has no WebSocket
  # support). If Passenger runs several processes of the app, consecutive polling
  # requests of one client must reach the same process: sticky sessions do that.
  PassengerStickySessions on
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
