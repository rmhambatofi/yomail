# ---- apps/api ----
NODE_ENV=development
PORT=3000                        # ignored by Passenger in production
API_PREFIX=api
PUBLIC_BASE_URL=http://localhost:5173   # base of the capture URLs returned by the API (prod: https://yo.manitra.fr)
WEB_DIST_DIR=                    # built SPA served by Nest (prod: ../web/dist); empty in dev, Vite serves it
TRUST_PROXY=0                    # 1 behind Apache/Passenger so req.ip reflects X-Forwarded-For
DB_HOST=localhost
DB_PORT=3307                     # docker-compose maps container 3306 -> host 3307
DB_USER=yomail
DB_PASSWORD=yomail
DB_NAME=yomail
MAX_BODY_BYTES=524288            # 512 KB per request body; larger bodies get 413 and are not stored
MAX_REQUESTS_PER_ENDPOINT=500    # oldest requests beyond this are dropped on insert
RETENTION_DAYS_DEFAULT=10        # used when the settings table is empty
UNCONFIRMED_USER_TTL_DAYS=7      # accounts never confirmed are purged after this many days

# ---- member features (phase 8): endpoints owned by a signed-in member ----
MAX_REQUESTS_PER_ENDPOINT_MEMBERS=2000   # cap for owned endpoints (anonymous ones keep MAX_REQUESTS_PER_ENDPOINT)
RETENTION_DAYS_MEMBERS_DEFAULT=30        # used when settings.retention_days_members is missing
REPLAY_TIMEOUT_MS=10000                  # replay: total time allowed for the outgoing request
REPLAY_ALLOW_PRIVATE=0                   # 1 = replay may target loopback/private addresses (tests only; refused in production)

# ---- user accounts (phase 7) ----
SESSION_TTL_DAYS=30              # login session lifetime (cookie + sessions table)
CONFIRM_TOKEN_TTL_HOURS=48       # validity of the confirmation link
RESET_TOKEN_TTL_MINUTES=60       # validity of the password reset link
AUTH_RATE_LIMIT=10               # requests per IP and window on sign-up / login / token routes
AUTH_RATE_WINDOW_MINUTES=15
# Outside production (NODE_ENV != production) no email is sent: every message is stored by the
# dev mail catcher (table caught_mails) and readable at http://localhost:<PORT>/devmailcatcher
# (JSON: /devmailcatcher/messages.json). The catcher exists in every environment (admin-only):
# other applications push their emails to it with POST /devmailcatcher/messages.json.
# In production the SMTP_* keys are required and point at the cPanel mail server.
SMTP_HOST=                       # prod: mail.manitra.fr (required when NODE_ENV=production)
SMTP_PORT=465
SMTP_SECURE=1                    # 1 = implicit TLS (465); 0 = plain/STARTTLS
SMTP_USER=                       # prod: no-reply@manitra.fr ; empty = no authentication
SMTP_PASSWORD=
MAIL_FROM="yomail <no-reply@localhost>"   # prod: "yomail <no-reply@manitra.fr>"
CORS_ORIGIN=http://localhost:5173   # /api routes only; capture routes always answer with *
