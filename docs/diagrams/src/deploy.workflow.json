  "cards": [
    {
      "dot": "cyan",
      "title": "What is uploaded",
      "items": [
        "package.json, package-lock.json, .nvmrc, packages/shared/dist, apps/api/dist, apps/web/dist, deploy files",
        "Never src, node_modules or .env: server config lives only in ~/yomail/apps/api/.env"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the merge is careful",
      "items": [
        "cPanel owns a fenced Passenger block in .htaccess; only the last block is kept",
        "The fence markers are matched at the start of a line and never quoted in full in deploy/htaccess"
      ]
    },
    {
      "dot": "amber",
      "title": "Flags",
      "items": [
        "--dry-run, --skip-build, --no-migrate; SSH_BATCH=0 allows password prompts",
        "Hourly cron runs npm run purge outside Passenger"
      ]
    }
  ]
