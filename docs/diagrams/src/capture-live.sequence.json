  "cards": [
    {
      "dot": "emerald",
      "title": "Capture rules",
      "items": [
        "Validate the UUID, check the endpoint exists, only then read the body",
        "413 above MAX_BODY_BYTES and nothing stored; HEAD answers 200 without body",
        "Oldest rows beyond MAX_REQUESTS_PER_ENDPOINT are dropped on insert"
      ]
    },
    {
      "dot": "violet",
      "title": "Two delivery paths",
      "items": [
        "Same process: LiveEventsService pushes to the Socket.IO room immediately",
        "Other processes: ChangeDetector polls the DB for subscribed endpoints",
        "Both paths may emit the same row; the server remembers ids 15 s, the client dedupes by id"
      ]
    },
    {
      "dot": "amber",
      "title": "Degraded modes",
      "items": [
        "Socket down: the inbox polls REST every 5 s (badge polling)",
        "REST failing too: badge offline, full reload on reconnect"
      ]
    }
  ]
